NODE_ENV=development
HOST=127.0.0.1
PORT=3000
CORS_ORIGIN=*
AUTH_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long

# Configure either DATABASE_URL or PGHOST, PGDATABASE, and PGUSER.
# Supply PGPASSWORD when required by your local PostgreSQL authentication setup.
DATABASE_URL=
PGHOST=localhost
PGPORT=5432
PGDATABASE=lendr_dev
PGUSER=your_postgres_user
PGPASSWORD=your_postgres_password
# Required when running database migrations. Set these to the verified Neon target.
MIGRATION_EXPECTED_NEON_PROJECT_ID=
MIGRATION_EXPECTED_NEON_BRANCH_ID=
